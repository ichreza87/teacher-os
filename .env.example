DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

POSTHOG_KEY=
POSTHOG_HOST=
ANALYTICS_ENABLED=true

NEXT_PUBLIC_APP_URL=http://localhost:3000

AI_PROVIDER=mock
AI_API_KEY=

# Login ujicoba admin/admin (data contoh). Default aktif di development,
# mati di production kecuali diisi "true".
DEMO_MODE=true

# Batasi login ke domain email tertentu (default: belajar.id saja).
# Belajar.id memakai subdomain (guru.sma.belajar.id, guru.sd.belajar.id, ...)
# sehingga dicek setelah OAuth, bukan via parameter hd Google.
ALLOWED_LOGIN_DOMAINS=belajar.id

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APP_ENCRYPTION_KEY=
